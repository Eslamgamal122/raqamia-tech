# Hostinger Node.js 24; configure these in hPanel (never commit real values).
NODE_ENV=production
APP_URL=https://your-domain.example
# Required in production: absolute PRIVATE persistent directory outside build/deploy files.
# Get the correct writable path from your hosting panel/support before deployment.
DATA_DIR=/absolute/persistent/raqamia-data
SITE_CONNECTION_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# First startup of an EMPTY database only. Remove these after initial setup.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional ONLY if the hosting proxy overwrites this header and blocks direct ingress:
# TRUSTED_PROXY_IP_HEADER=x-forwarded-for
# PORT is normally injected by Hostinger.
